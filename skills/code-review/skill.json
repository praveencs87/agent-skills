{
    "name": "code-review",
    "version": "1.0.0",
    "description": "Review code changes for bugs, best practices, and security issues",
    "tools": [
        "cmd.run",
        "git.diff",
        "fs.read"
    ],
    "permissions": {
        "required": [
            "exec",
            "filesystem.read"
        ]
    },
    "entrypoint": "prompt.md",
    "state": "approved"
}